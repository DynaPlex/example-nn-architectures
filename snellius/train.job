#!/bin/bash
#SBATCH --job-name=dvrp
#SBATCH --partition=genoa
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=192
#SBATCH --time=01:00:00
#SBATCH --output=results/dvrp-%j.out

# Run one of the repository's scripts on a full Genoa node. Submit FROM THE
# REPO ROOT after snellius/setup.sh (which creates .venv and results/):
#
#     sbatch snellius/train.job train_dcl.py
#     sbatch --time=08:00:00 snellius/train.job compare_architectures.py
#
# The scripts carry their own budgets (edit the constants at their top); DCL's
# machine plan "auto" recognizes the allocation and sizes the collection to it.
cd "$SLURM_SUBMIT_DIR"
source .venv/bin/activate
echo "node: $(hostname)  cores: $SLURM_CPUS_PER_TASK  script: $1"
lscpu | grep "Model name"
python -u "$@"
echo done
